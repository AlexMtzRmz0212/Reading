# Notion: create an internal integration at https://www.notion.so/profile/integrations
# and connect the "Reading List" database to it (… menu > Connections).
NOTION_TOKEN=
# The "Reading List" database (the id is the 32-character part of its URL).
READING_DATABASE_ID=ac0b71ef-d599-4f37-bd65-02a625aba8b1

# Password gate for the owner tools + secret used to sign the session cookie (any long random string).
APP_PASSWORD=
SESSION_SECRET=

# Optional: your time zone, so "today" (Started / Completed stamps) turns over at your midnight, not UTC's.
# TIME_ZONE=America/Mexico_City

# Optional: Google Books as a second search source on the Add page.
# GOOGLE_BOOKS_API_KEY=
